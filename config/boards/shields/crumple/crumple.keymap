#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NAV 1
#define SYMB 2
#define FUNC 3

&sk {
  release-after-ms = <500>;
  quick-release;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <150>;
  quick-tap-ms = <200>;
};

// &mmv {
  // time-to-max-speed-ms = <300>;
  // acceleration-exponent = <1>;
// };

/ {
  combos {
    compatible = "zmk,combos";
    z {
      timeout-ms = <40>;
      key-positions = <11 12>;
      bindings = <&kp Z>;
      layers = <DEFAULT>;
    };
    b {
      timeout-ms = <40>;
      key-positions = <12 13>;
      bindings = <&kp B>;
      layers = <DEFAULT>;
    };
    j {
      timeout-ms = <40>;
      key-positions = <16 17>;
      bindings = <&kp J>;
      layers = <DEFAULT>;
    };
    slash {
      timeout-ms = <40>;
      key-positions = <17 18>;
      bindings = <&kp FSLH>;
      layers = <DEFAULT>;
    };

    britup {
      timeout-ms = <50>;
      key-positions = <1 2 3>;
      bindings = <&kp C_BRI_UP>;
      layers = <DEFAULT>;
    };
    caps {
      timeout-ms = <50>;
      key-positions = <11 12 13>;
      bindings = <&kp CAPS>;
      layers = <DEFAULT>;
    };
    britdn {
      timeout-ms = <50>;
      key-positions = <20 21 22>;
      bindings = <&kp C_BRI_DN>;
      layers = <DEFAULT>;
    };
    volup {
      timeout-ms = <50>;
      key-positions = <6 7 8>;
      bindings = <&kp C_VOL_UP>;
      layers = <DEFAULT>;
    };
    volmt {
      timeout-ms = <50>;
      key-positions = <16 17 18>;
      bindings = <&kp C_MUTE>;
      layers = <DEFAULT>;
    };
    voldn {
      timeout-ms = <50>;
      key-positions = <25 26 27>;
      bindings = <&kp C_VOL_DN>;
      layers = <DEFAULT>;
    };

    bksp {
      timeout-ms = <50>;
      key-positions = <21 22>;
      bindings = <&kp BKSP>;
      layers = <NAV>;
    };
    prev {
      timeout-ms = <50>;
      key-positions = <25 26>;
      bindings = <&kp C_PREV>;
      layers = <NAV>;
    };
    next {
      timeout-ms = <50>;
      key-positions = <26 27>;
      bindings = <&kp C_NEXT>;
      layers = <NAV>;
    };

    lpar {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&kp LPAR>;
      layers = <SYMB>;
    };
    rpar {
      timeout-ms = <50>;
      key-positions = <16 17>;
      bindings = <&kp RPAR>;
      layers = <SYMB>;
    };
    lbkt {
      timeout-ms = <50>;
      key-positions = <11 12>;
      bindings = <&kp LBKT>;
      layers = <SYMB>;
    };
    rbkt {
      timeout-ms = <50>;
      key-positions = <17 18>;
      bindings = <&kp RBKT>;
      layers = <SYMB>;
    };
    lbrc {
      timeout-ms = <50>;
      key-positions = <2 3>;
      bindings = <&kp LBRC>;
      layers = <SYMB>;
    };
    rbrc {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&kp RBRC>;
      layers = <SYMB>;
    };
    lt {
      timeout-ms = <50>;
      key-positions = <1 2>;
      bindings = <&kp LT>;
      layers = <SYMB>;
    };
    gt {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&kp GT>;
      layers = <SYMB>;
    };

    btclr {
      timeout-ms = <50>;
      key-positions = <10 19>;
      bindings = <&bt BT_CLR>;
      layers = <FUNC>;
    };
    f9 {
      timeout-ms = <50>;
      key-positions = <1 2>;
      bindings = <&kp F9>;
      layers = <FUNC>;
    };
    f10 {
      timeout-ms = <50>;
      key-positions = <2 3>;
      bindings = <&kp F10>;
      layers = <FUNC>;
    };
    f11 {
      timeout-ms = <50>;
      key-positions = <20 21>;
      bindings = <&kp F11>;
      layers = <FUNC>;
    };
    f12 {
      timeout-ms = <50>;
      key-positions = <21 22>;
      bindings = <&kp F12>;
      layers = <FUNC>;
    };
    bt0 {
      timeout-ms = <50>;
      key-positions = <11 12>;
      bindings = <&bt BT_SEL 0>;
      layers = <FUNC>;
    };
    btnxt {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&bt BT_NXT>;
      layers = <FUNC>;
    };
    scrl_left {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&msc SCRL_LEFT>;
      layers = <FUNC>;
    };
    scrl_right {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&msc SCRL_RIGHT>;
      layers = <FUNC>;
    };
  };

  behaviors {
    lm: layer_mod {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <150>;
      quick-tap-ms = <200>;
      bindings = <&mo>, <&sk>;
    };
    smt: sticky_mod_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <150>;
      quick-tap-ms = <200>;
      bindings = <&sk>, <&kp>;
    };

    shftcmma: shift_comma {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp CMMA>, <&kp QMARK>;
      mods = <(MOD_LSFT)>;
    };
    shftdot: shift_dot {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp BANG>;
      mods = <(MOD_LSFT)>;
    };
    shft1: shift_1 {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp N1>, <&kp COMMA>;
      mods = <(MOD_LSFT)>;
    };

    conditional_layers {
      compatible = "zmk,conditional-layers";
      tri_layer {
        if-layers = <NAV SYMB>;
        then-layer = <FUNC>;
      };
    };
  };

  keymap {
    compatible = "zmk,keymap";
    default_layer {
      bindings = <
        &kp Q  &kp W  &kp E  &kp R  &kp T                           &kp Y  &kp U  &kp I   &kp O     &kp QUOT
        &kp A  &kp S  &kp D  &kp F  &kp G                           &kp H  &kp N  &kp K   &kp L     &kp P
               &kp X  &kp C  &kp V  &lm NAV LC(LA(LSFT))   &lt SYMB SPACE  &kp M  &shftcmma  &shftdot
      >;
    };

    nav_layer {
      bindings = <
        &kp ESC   &sk RALT  &key_repeat  &caps_word  &sl FUNC       &kp PG_UP     &kp LBKT        &kp UP          &kp RBKT        &kp END
        &sk LCTL  &sk LALT  &sk LGUI     &sk LSFT    &kp GLOBE        &kp PG_DN     &kp LEFT        &kp DOWN        &kp RIGHT       &kp ENTER
                  &kp TAB   &kp ENTER    &kp SPC     &none            &lt SYMB BKSP  &kp LG(Z)      &kp C_PP        &kp LG(LS(Z))
      >;
    };

    symbols_layer {
      bindings = <
        &kp DOT    &shft1   &kp N2  &kp N3  &kp STAR         &kp PLUS   &kp GRAV   &kp AMPS   &kp PIPE   &kp BSLH
        &kp ATSN     &kp N4  &kp N5  &kp N6  &kp N0          &kp EQUAL  &smt LSFT MINUS  &smt LGUI UNDER  &smt LALT COLON   &smt LCTL SEMI
                    &kp N7  &kp N8  &kp N9  &lm NAV LSFT    &none   &kp FSLH   &kp DLLR   &kp TILDE
      >;
    };

    function_layer {
      bindings = <
        &kp F1    &kp F2     &kp F3     &kp F4     &kp F5             &bt BT_SEL 0   &msc SCRL_DOWN  &mmv MOVE_UP     &msc SCRL_UP     &kp LS(LG(LC(N4)))
        &kp LCTL  &mkp MCLK  &mkp RCLK  &mkp LCLK  &bootloader        &bt BT_NXT     &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &kp LS(LG(N5))
                &kp F6     &kp F7    &kp F8    &none                  &none     &kp LSFT        &kp LGUI         &kp LALT
      >;
    };
  };
};
