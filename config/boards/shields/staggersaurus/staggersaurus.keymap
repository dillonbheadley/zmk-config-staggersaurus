#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define ALT 1
#define NAV 2
// #define NUMB 3
#define SYMB 3
#define FUNC 4
#define GAME 5

&sk {
  release-after-ms = <500>;
  quick-release;
};

&sl {
  release-after-ms = <500>;
};

&mmv {
  // trigger-period-ms = <2>;
  // time-to-max-speed-ms = <2>;
  acceleration-exponent = <1>;
};

/ {
  combos {
    compatible = "zmk,combos";
    cmb_rpar {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&kp RPAR>;
      layers = <SYMB>;
    };
    cmb_rbkt {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&kp RBKT>;
      layers = <SYMB>;
    };
    cmb_rbrc {
      timeout-ms = <50>;
      key-positions = <26 27>;
      bindings = <&kp RBRC>;
      layers = <SYMB>;
    };
    cmb_gt {
      timeout-ms = <50>;
      key-positions = <27 28>;
      bindings = <&kp GT>;
      layers = <SYMB>;
    };
    cmb_bang {
      timeout-ms = <50>;
      key-positions = <11 12>;
      bindings = <&kp BANG>;
      layers = <DEFAULT>;
    };
    cmb_qmark {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&kp QMARK>;
      layers = <DEFAULT>;
    };
    cmb_btclr {
      timeout-ms = <50>;
      key-positions = <21 24>;
      bindings = <&bt BT_CLR>;
      layers = <FUNC>;
    };
    cmb_scrl_left {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&msc SCRL_LEFT>;
      layers = <FUNC>;
    };
    cmb_scrl_right {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&msc SCRL_RIGHT>;
      layers = <FUNC>;
    };
  };

  // Maybe put these in combos if no encoders
  // &kp C_BRI_UP  &kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP 
  behaviors {
    ml: mod_layer {
      compatible = "zmk,behavior-hold-tap";
      label = "MOD_LAYER";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <150>;
      bindings = <&mo>, <&sk>;
    };
    shftcmma: shift_comma {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp CMMA>, <&kp QMARK>;
      mods = <(MOD_LSFT)>;
    };
    shftdot: shift_dot {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp BANG>;
      mods = <(MOD_LSFT)>;
    };
    shftslash: shift_slash {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp FSLH>, <&kp UNDER>;
      mods = <(MOD_LSFT)>;
    };
    shftbrkt: shift_bracket {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp LBKT>, <&kp RBKT>;
      mods = <(MOD_LSFT)>;
    };
    shftbrce: shift_brace {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp LBRC>, <&kp RBRC>;
      mods = <(MOD_LSFT)>;
    };
    shftpren: shift_paren {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp LPAR>, <&kp RPAR>;
      mods = <(MOD_LSFT)>;
    };
    shftabra: shift_angle_bracket {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp LT>, <&kp GT>;
      mods = <(MOD_LSFT)>;
    };
    spcbspc: space_backspace {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp SPACE>, <&kp BKSP>;
      mods = <(MOD_LSFT)>;
    };
    rmclick: right_mid_click{
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&mkp RCLK>, <&mkp MCLK>;
      mods = <(MOD_LSFT)>;
    };
    mouse_scroll_encoder: mouse_scroll_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      tap-ms = <80>;
      bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
    };
    mouse_scroll_x_encoder: mouse_scroll_x_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      tap-ms = <80>;
      bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
    };
    // mouse_move_x_encoder: mouse_move_x_encoder {
    //   compatible = "zmk,behavior-sensor-rotate";
    //   #sensor-binding-cells = <0>;
    //   tap-ms = <40>;
    //   bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
    // };
    // mouse_move_y_encoder: mouse_move_y_encoder {
    //   compatible = "zmk,behavior-sensor-rotate";
    //   #sensor-binding-cells = <0>;
    //   tap-ms = <40>;
    //   bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
    // };

    conditional_layers {
      compatible = "zmk,conditional-layers";
      tri_layer {
        if-layers = <NAV SYMB>;
        then-layer = <FUNC>;
      };
    };

  };

  keymap {
    compatible = "zmk,keymap";
    default_layer {
      bindings = <
        &kp Q  &kp W  &kp E  &kp R  &kp T           &kp Y  &kp U  &kp I   &kp O     &kp QUOT 
        &kp A  &kp S  &kp D  &kp F  &kp G           &kp H  &kp J  &kp K   &kp L     &kp P   
        &kp Z  &kp X  &kp C  &kp V  &kp B           &kp N  &kp M  &shftcmma  &shftdot  &shftslash
            &trans  &sk LSFT  &ml NAV LGUI          &ml SYMB LC(LG(LALT))  &spcbspc  &trans
      >;
      sensor-bindings = <&inc_dec_kp TAB LS(TAB) &mouse_scroll_encoder>;
    };

    // engram layout flipped
    //     &kp V  &kp G  &kp D  &kp L  &kp Z              &kp QUOT  &kp U  &kp O  &kp Y  &kp B 
    //     &kp N  &kp S  &kp T  &kp H  &kp CMMA           &kp DOT   &kp A  &kp E  &kp I  &kp C
    //     &kp P  &kp F  &kp M  &kp R  &kp Q              &kp FSLH  &kp K  &kp J  &kp X  &kp W
    alt_layer { // northstar layout
      bindings = <
        &kp Q  &kp W  &kp M  &kp B  &kp Z              &kp J  &kp F  &kp O  &kp U  &kp QUOT
        &kp N  &kp R  &kp S  &kp T  &kp G              &kp Y  &kp H  &kp E  &kp I  &kp A
        &kp X  &kp L  &kp C  &kp D  &kp V              &kp K  &kp P  &shftcmma  &shftdot  &shftslash
            &trans  &sk LSFT  &ml NAV LGUI             &mo SYMB  &spcbspc  &trans

      >;
      // &trans  &ml NAV LSFT  &ml NUMB LGUI        &mo SYMB  &kp SPACE  &trans
      sensor-bindings = <&inc_dec_kp TAB LS(TAB) &mouse_scroll_encoder>;
    };

    nav_layer {
      bindings = <
        &tog GAME  &sk RALT  &key_repeat  &caps_word  &sk GLOBE             &kp PG_UP     &kp LBKT        &kp UP          &kp RBKT        &tog ALT 
        &sk LCTL  &sk LALT  &sk LGUI      &sk LSFT    &sk LC(RS(LALT))      &kp PG_DN     &kp LEFT        &kp DOWN        &kp RIGHT       &kp ENTER
        &kp ESC   &kp TAB   &kp ENTER     &kp SPC     &kp BKSP              &kp LC(MINUS) &kp C_PREV      &kp C_PP        &kp C_NEXT        &kp DEL 
                                        &trans  &trans  &none               &trans  &kp BKSP  &trans
      >;
      sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp LS(LG(Z)) LG(Z)>;
    };

    // number_layer {
    //   bindings = <
    //     &kp C_BRI_UP  &kp C_PREV  &kp C_PP      &kp C_NEXT  &kp STAR          &kp MINUS  &kp N1  &kp N2  &kp N3  &kp CMMA
    //     &kp LCTL      &kp LALT    &kp LGUI      &kp LSFT    &kp PLUS          &kp COLON  &kp N4  &kp N5  &kp N6  &kp N0 
    //     &kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp FSLH        &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp DOT   
    //                                         &trans  &trans  &none             &trans  &kp BKSP  &trans
    //   >;
    //   sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &mouse_scroll_encoder>;
    // };

    symbols_layer {
      // doubles ! ? - ' "
      // &kp PRCT  &kp DLLR  &kp HASH    &kp ATSN  &kp STAR        &kp CRRT    &kp QUOT   &kp GRAV    &kp DQT    &kp TILDE
      // &kp PIPE  &kp AMPS  &kp QMARK   &kp BANG  &kp PLUS        &kp COLON   &kp MINUS  &kp UNDER   &kp EQUAL  &kp SEMI
      // &kp LT    &kp LBKT  &kp LPAR    &kp LBRC  &kp BSLH        &kp FSLH    &kp RBRC   &kp RPAR    &kp RBKT   &kp GT

      // &kp LBKT   &kp RBKT  &kp LPAR   &kp RPAR  &kp PLUS        &kp SEMI   &kp N1  &kp N2  &kp N3  &kp CMMA
      // &kp PIPE   &kp AMPS  &kp MINUS  &kp GRAV  &kp TILDE       &kp COLON  &kp N4  &kp N5  &kp N6  &kp N0
      // &kp LT     &kp GT    &kp LBRC   &kp RBRC  &kp BSLH        &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp DOT
      
      bindings = <
        &kp PRCT    &kp N1  &kp N2  &kp N3  &kp STAR        &kp PLUS   &kp LPAR   &kp LBKT   &kp PIPE   &kp TILDE  
        &kp SEMI    &kp N4  &kp N5  &kp N6  &kp ATSN        &kp EQUAL  &kp MINUS  &kp GRAV   &kp AMPS   &kp COLON  
        &kp CMMA    &kp N7  &kp N8  &kp N9  &kp HASH        &kp CRRT   &kp LBRC   &kp LT     &kp DLLR  &kp BSLH 
                          &trans  &mt LSFT N0  &trans      &none  &sk LGUI  &trans
      >;
      sensor-bindings = <&inc_dec_kp DOWN UP &inc_dec_kp C_VOL_UP C_VOL_DN>;
    }; 

        // &kp F1  &kp F2    &kp F3    &kp F4    &bt BT_SEL 0         &kp C_BRI_UP  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &tog GAME
        // &kp F5  &kp F6    &kp F7    &kp F8    &bt BT_NXT           &kp C_BRI_DN  &kp LSFT      &kp LGUI    &kp LALT      &kp LCTL 
        // &kp F9  &kp F10   &kp F11   &kp F12   &bt BT_PRV           &sys_reset    &kp C_PREV    &kp C_PP    &kp C_NEXT    &tog ALT   
    function_layer {
      bindings = <
        &kp F1    &kp F2    &kp F3      &kp F4    &kp F5          &bt BT_SEL 0   &msc SCRL_DOWN  &mmv MOVE_UP     &msc SCRL_UP    &bt BT_CLR
        &kp F6    &kp F7    &sk LSFT   &mkp LCLK  &rmclick        &bt BT_NXT     &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &kp LC(UP)  
        &kp F8    &kp F9    &kp F10      &kp F11  &kp F12         &bt BT_PRV     &sk LSFT        &sk LGUI         &sk LALT        &sk LCTL    
                            &trans  &bootloader  &none            &none  &mkp MCLK  &trans
      >;
      sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &mouse_scroll_x_encoder>;
    };

    game_layer {
      bindings = <
        &kp ESC  &kp Q  &kp W  &kp E  &kp R             &kp T  &kp N1  &kp UP  &kp N2  &kp BKSP 
        &kp TAB  &kp A  &kp S  &kp D  &kp F             &kp G  &kp LEFT  &kp DOWN  &kp RIGHT  &kp ENTER
        &kp LSFT  &kp Z  &kp X  &kp C  &kp V            &kp B  &kp N3  &kp N4  &kp N5  &kp N6
                    &trans  &kp SPC  &kp LCTL           &tog GAME  &kp SPC &trans
      >;
      sensor-bindings = <&inc_dec_kp TAB LS(TAB) &inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
