#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NAV 1
// #define NUMB 3
#define SYMB 2
#define FUNC 3
#define GAME 4

&sk {
  release-after-ms = <500>;
  quick-release;
};

&sl {
  release-after-ms = <500>;
};

&lt {
  flavor = "balanced";
  quick-tap-ms = <200>;
};

&mmv {
  // trigger-period-ms = <2>;
  // time-to-max-speed-ms = <2>;
  acceleration-exponent = <1>;
};

/ {
  combos {
    compatible = "zmk,combos";
    z {
      timeout-ms = <50>;
      key-positions = <11 12>;
      bindings = <&kp Z>;
      layers = <DEFAULT>;
    };
    b {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&kp B>;
      layers = <DEFAULT>;
    };
    cmd {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&sk LGUI>;
      layers = <DEFAULT>;
    };
    shrtct {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&sk LC(LA(LGUI))>;
      layers = <DEFAULT>;
    };
    j {
      timeout-ms = <50>;
      key-positions = <16 17>;
      bindings = <&kp J>;
      layers = <DEFAULT>;
    };
    slash {
      timeout-ms = <50>;
      key-positions = <17 18>;
      bindings = <&kp FSLH>;
      layers = <DEFAULT>;
    };

    codeprev {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&kp LC(MINUS)>;
      layers = <NAV>;
    };
    codenext {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&kp LC(LS(MINUS))>;
      layers = <NAV>;
    };
    prev {
      timeout-ms = <50>;
      key-positions = <26 27>;
      bindings = <&kp C_PREV>;
      layers = <NAV>;
    };
    next {
      timeout-ms = <50>;
      key-positions = <27 28>;
      bindings = <&kp C_NEXT>;
      layers = <NAV>;
    };

    lpar {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&kp LPAR>;
      layers = <SYMB>;
    };
    rpar {
      timeout-ms = <50>;
      key-positions = <16 17>;
      bindings = <&kp RPAR>;
      layers = <SYMB>;
    };
    lbkt {
      timeout-ms = <50>;
      key-positions = <11 12>;
      bindings = <&kp LBKT>;
      layers = <SYMB>;
    };
    rbkt {
      timeout-ms = <50>;
      key-positions = <17 18>;
      bindings = <&kp RBKT>;
      layers = <SYMB>;
    };
    lbrc {
      timeout-ms = <50>;
      key-positions = <2 3>;
      bindings = <&kp LBRC>;
      layers = <SYMB>;
    };
    rbrc {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&kp RBRC>;
      layers = <SYMB>;
    };
    lt {
      timeout-ms = <50>;
      key-positions = <1 2>;
      bindings = <&kp LT>;
      layers = <SYMB>;
    };
    gt {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&kp GT>;
      layers = <SYMB>;
    };

    cmb_btclr {
      timeout-ms = <50>;
      key-positions = <10 19>;
      bindings = <&bt BT_CLR>;
      layers = <FUNC>;
    };
    cmb_scrl_left {
      timeout-ms = <50>;
      key-positions = <7 8>;
      bindings = <&msc SCRL_LEFT>;
      layers = <FUNC>;
    };
    cmb_scrl_right {
      timeout-ms = <50>;
      key-positions = <6 7>;
      bindings = <&msc SCRL_RIGHT>;
      layers = <FUNC>;
    };
  };

  // Maybe put these in combos if no encoders
  // &kp C_BRI_UP  &kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP 
  behaviors {
    ml: mod_layer {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      tapping-term-ms = <150>;
      bindings = <&mo>, <&sk>;
    };
    shftcmma: shift_comma {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp CMMA>, <&kp QMARK>;
      mods = <(MOD_LSFT)>;
    };
    shftdot: shift_dot {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp BANG>;
      mods = <(MOD_LSFT)>;
    };
    shftslash: shift_slash {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&kp FSLH>, <&kp UNDER>;
      mods = <(MOD_LSFT)>;
    };
    mouse_scroll_encoder: mouse_scroll_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      tap-ms = <80>;
      bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
    };
    mouse_scroll_x_encoder: mouse_scroll_x_encoder {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      tap-ms = <80>;
      bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
    };
    // mouse_move_x_encoder: mouse_move_x_encoder {
    //   compatible = "zmk,behavior-sensor-rotate";
    //   #sensor-binding-cells = <0>;
    //   tap-ms = <40>;
    //   bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
    // };
    // mouse_move_y_encoder: mouse_move_y_encoder {
    //   compatible = "zmk,behavior-sensor-rotate";
    //   #sensor-binding-cells = <0>;
    //   tap-ms = <40>;
    //   bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
    // };

    conditional_layers {
      compatible = "zmk,conditional-layers";
      tri_layer {
        if-layers = <NAV SYMB>;
        then-layer = <FUNC>;
      };
    };

  };

  keymap {
    compatible = "zmk,keymap";
    default_layer {
      bindings = <
        &kp Q  &kp W  &kp E  &kp R  &kp T           &kp Y  &kp U  &kp I   &kp O     &kp QUOT 
        &kp A  &kp S  &kp D  &kp F  &kp G           &kp H  &kp N  &kp K   &kp L     &kp P   
        &kp Z  &kp X  &kp C  &kp V  &kp B           &kp J  &kp M  &shftcmma  &shftdot  &shftslash
            &trans  &ml NAV LSFT  &sk LGUI          &sk LC(LG(LALT))  &lt SYMB SPACE  &trans
      >;
      sensor-bindings = <&inc_dec_kp TAB LS(TAB) &mouse_scroll_encoder>;
    };

    nav_layer {
      bindings = <
        &kp ESC   &sk RALT  &key_repeat  &sk LC(RS(LALT))  &sk GLOBE        &kp PG_UP     &kp LBKT        &kp UP          &kp RBKT        &trans 
        &sk LCTL  &sk LALT  &sk LGUI      &sk LSFT    &caps_word            &kp PG_DN     &kp LEFT        &kp DOWN        &kp RIGHT       &kp ENTER
        &kp CAPS   &kp TAB   &kp ENTER     &kp SPC     &kp BKSP              &kp LC(MINUS)  &kp LG(Z)      &kp C_PP        &kp LG(LS(Z))        &kp DEL 
                                        &trans  &none  &trans               &trans  &lt SYMB BKSP  &trans
      >;
      sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp LS(LG(Z)) LG(Z)>;
    };

    symbols_layer {      
      bindings = <
        &kp DOT    &kp N1  &kp N2  &kp N3  &kp STAR       &kp PLUS   &kp GRAV   &kp AMPS   &kp PIPE   &kp TILDE  
        &kp ATSN    &kp N4  &kp N5  &kp N6  &kp N0        &kp EQUAL  &kp MINUS  &kp UNDER  &kp COLON   &kp SEMI  
        &kp CMMA    &kp N7  &kp N8  &kp N9  &kp HASH      &kp CRRT   &kp FSLH   &kp DLLR   &kp PRCT  &kp BSLH 
                          &trans  &lt NAV BKSP  &trans    &sk LGUI  &none  &trans
      >;
      sensor-bindings = <&inc_dec_kp DOWN UP &inc_dec_kp C_VOL_UP C_VOL_DN>;
    }; 

        // &kp F1  &kp F2    &kp F3    &kp F4    &bt BT_SEL 0         &kp C_BRI_UP  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &tog GAME
        // &kp F5  &kp F6    &kp F7    &kp F8    &bt BT_NXT           &kp C_BRI_DN  &kp LSFT      &kp LGUI    &kp LALT      &kp LCTL 
        // &kp F9  &kp F10   &kp F11   &kp F12   &bt BT_PRV           &sys_reset    &kp C_PREV    &kp C_PP    &kp C_NEXT    &tog ALT   
    function_layer {
      bindings = <
        &kp F1  &kp F2     &kp F3     &kp F4     &kp F5        &bt BT_SEL 0   &msc SCRL_DOWN  &mmv MOVE_UP     &msc SCRL_UP     &bt BT_CLR
        &sk F6  &mkp MCLK  &mkp RCLK  &mkp LCLK  &kp F7        &bt BT_NXT     &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &kp LC(UP)  
        &kp F8  &kp F9     &kp F10    &kp F11    &kp F12       &bt BT_PRV     &sk LSFT        &sk LGUI         &sk LALT         &sk LCTL    
                            &trans  &none  &bootloader            &trans  &none  &trans
      >;
      sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &mouse_scroll_x_encoder>;
    };

    game_layer {
      bindings = <
        &kp ESC  &kp Q  &kp W  &kp E  &kp R             &kp T  &kp N1  &kp UP  &kp N2  &kp BKSP 
        &kp TAB  &kp A  &kp S  &kp D  &kp F             &kp G  &kp LEFT  &kp DOWN  &kp RIGHT  &kp ENTER
        &kp LSFT  &kp Z  &kp X  &kp C  &kp V            &kp B  &kp N3  &kp N4  &kp N5  &kp N6
                    &trans  &kp SPC  &kp LCTL           &tog GAME  &kp SPC &trans
      >;
      sensor-bindings = <&inc_dec_kp TAB LS(TAB) &inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
